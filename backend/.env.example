# Change these before exposing an instance to other users.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=deepshield
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_SECRET
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MODEL_MODE=simulation
# Actual evidence providers (optional; leave blank for graceful unavailable status)
TAVILY_API_KEY=
GOOGLE_FACTCHECK_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# FUTURE: paths to trained model artifacts exported from Colab
TEXT_MODEL_PATH=
MULTIMODAL_MODEL_PATH=
# Optional: semantic evidence ranking (default TF-IDF). The Trust Score was fitted on TF-IDF relevance; refit it if you enable this.
EMBEDDING_MODEL=
# Optional: out-of-domain check (python -m research.fit_domain writes the directory)
DOMAIN_MODEL_PATH=
